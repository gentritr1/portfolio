{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/showcase/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/mobile/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/personal/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/Gentrit-Rashiti-CV.pdf", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/og-image.jpg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/:slug(care-platform|design-system-react|bayyinah-tv|read-to-feed|viva-fresh|dukagjini-bookstore|incentiv|futurisma|offday|leakscan)", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/work/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/drafts/refractive-engine", "destination": "/", "permanent": true },
    { "source": "/drafts/refractive-engine/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/workflow", "destination": "/", "permanent": true },
    { "source": "/civiclee", "destination": "/", "permanent": true },
    { "source": "/design-system", "destination": "/design-system-react", "permanent": true }
  ]
}
